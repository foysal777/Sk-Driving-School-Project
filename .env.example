# ==============================================================================
# DriveMaster Driving School - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Square Payment Gateway (Sandbox Mode)
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_APP_ID=sandbox-sq0idb-your_application_id_here
SQUARE_SANDBOX_TOKEN=your_square_sandbox_access_token_here
SQUARE_SANDBOX_LOCATION=your_square_location_id_here
SQUARE_CURRENCY=USD

# SMTP Email Configuration (Gmail, Mailtrap, Brevo, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password

# Sender & Admin Notification Emails
MAIL_FROM_ADDRESS=notifications@yourdomain.com
MAIL_FROM_NAME="DriveMaster Driving Academy"
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
ADMIN_NAME="DriveMaster Admin Operations"

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drivemaster_db
DB_USER=root
DB_PASS=
